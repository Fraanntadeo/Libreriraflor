---
import Layout from "../layouts/Layout.astro";
import { CATEGORIES, PRODUCTS, TESTIMONIALS, INSTAGRAM_IMAGES } from "../data";
import CategoryCard from "../components/CategoryCard.astro";
import ProductCard from "../components/ProductCard.astro";
import SLabel from "../components/ui/SLabel.astro";
import Stars from "../components/ui/Stars.astro";

const featured = PRODUCTS.slice(0, 4);
const bestsellers = PRODUCTS.filter(
  (p) => p.badge === "bestseller" || p.rating >= 4.8
).slice(0, 4);

const wishlist = JSON.parse(Astro.locals?.wishlist || '[]');
---

<Layout title="Páginas — Papelería artesanal" current="home">
  {/* ── HERO ── */}
  <section class="grid grid-cols-1 md:grid-cols-2">
    <div class="flex flex-col justify-center px-8 md:px-16 py-20 md:py-28 bg-[#F9F5EF]">
      <SLabel>Papelería artesanal · Buenos Aires</SLabel>
      <h1
        style="font-family: 'DM Serif Display', Georgia, serif;"
        class="text-4xl md:text-5xl lg:text-[3.5rem] text-[#332C29] leading-[1.1] mb-5"
      >
        Papelería que
        <br />
        inspira tus días.
      </h1>
      <p class="text-base text-[#665C57] leading-relaxed max-w-sm mb-8">
        Cuadernos, agendas, planners y pequeños detalles pensados para
        acompañarte todos los días.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href="/category"
          class="px-6 py-3.5 bg-[#8E6F62] text-[#FFFDFC] rounded-full font-semibold hover:bg-[#6F554A] transition-colors duration-200 text-sm min-h-[44px] inline-block"
        >
          Ver productos
        </a>
        <a
          href="/about"
          class="px-6 py-3.5 border border-[#8E6F62] text-[#8E6F62] rounded-full font-semibold hover:bg-[#E9DDD7] transition-colors duration-200 text-sm min-h-[44px] inline-block"
        >
          Conocé nuestra historia
        </a>
      </div>
    </div>
    <div class="relative hidden md:block bg-[#E9DDD7] overflow-hidden min-h-[560px]">
      <img
        src="https://images.unsplash.com/photo-1775129667571-7fa3f51c05e3?w=900&h=1100&fit=crop&auto=format"
        alt="Escritorio de papelería artesanal"
        class="w-full h-full object-cover absolute inset-0"
      />
      <div class="absolute inset-0 bg-[#F9F5EF]/5" />
    </div>
  </section>

  {/* ── PERKS BAR ── */}
  <section class="border-y border-[#E6DDD6] bg-[#FFFDFC]">
    <div class="max-w-[1200px] mx-auto px-6 py-3.5">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-0 divide-x divide-[#E6DDD6]">
        {[
          { icon: "truck", text: "Envío gratis desde $3.000" },
          { icon: "shield", text: "Compra segura garantizada" },
          { icon: "refresh", text: "Cambios en 30 días" },
          { icon: "package", text: "Packaging artesanal" },
        ].map((item) => (
          <div key={item.text} class="flex items-center gap-2.5 px-5 py-2.5 first:pl-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#8E6F62" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0">
              {item.icon === "truck" && <><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></>}
              {item.icon === "shield" && <><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></>}
              {item.icon === "refresh" && <><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></>}
              {item.icon === "package" && <><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></>}
            </svg>
            <span class="text-xs text-[#665C57] font-medium">{item.text}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── CATEGORIES ── */}
  <section class="max-w-[1200px] mx-auto px-6 py-16 md:py-20">
    <div class="text-center mb-10">
      <SLabel>Categorías</SLabel>
      <h2 style="font-family: 'DM Serif Display', Georgia, serif;" class="text-3xl md:text-4xl text-[#332C29]">
        Explorá nuestra colección
      </h2>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
      {CATEGORIES.map((cat) => (
        <CategoryCard key={cat.id} category={cat} />
      ))}
    </div>
  </section>

  {/* ── FEATURED PRODUCTS ── */}
  <section class="bg-[#F9F5EF] py-16 md:py-20">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="flex items-end justify-between mb-10">
        <div>
          <SLabel>Destacados</SLabel>
          <h2 style="font-family: 'DM Serif Display', Georgia, serif;" class="text-3xl md:text-4xl text-[#332C29]">
            Productos destacados
          </h2>
        </div>
        <a
          href="/category"
          class="hidden md:flex items-center gap-1.5 text-sm text-[#8E6F62] font-semibold hover:gap-3 transition-all duration-200"
        >
          Ver todos
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {featured.map((p) => (
          <ProductCard
            key={p.id}
            product={p}
            inWishlist={wishlist.includes(p.id)}
          />
        ))}
      </div>
    </div>
  </section>

  {/* ── COLLECTION BANNER ── */}
  <section class="relative overflow-hidden bg-[#332C29] py-20 md:py-28">
    <div class="absolute inset-0">
      <img
        src="https://images.unsplash.com/photo-1609338177258-4ce9fafc513e?w=1400&h=700&fit=crop&auto=format"
        alt="Colección otoño"
        class="w-full h-full object-cover opacity-15"
      />
    </div>
    <div class="relative max-w-[1200px] mx-auto px-6 text-center">
      <SLabel>Colección especial</SLabel>
      <h2
        style="font-family: 'DM Serif Display', Georgia, serif;"
        class="text-4xl md:text-5xl text-[#E9DDD7] mb-4 leading-tight"
      >
        La colección otoño
        <br />
        ya está disponible.
      </h2>
      <p class="text-[#8C817B] mb-8 max-w-md mx-auto text-sm leading-relaxed">
        Tonos cálidos, papeles de temporada y diseños pensados para los días
        más tranquilos del año.
      </p>
      <a
        href="/category"
        class="px-8 py-3.5 bg-[#E9DDD7] text-[#332C29] rounded-full font-semibold hover:bg-[#FFFDFC] transition-colors duration-200 text-sm inline-block"
      >
        Ver colección
      </a>
    </div>
  </section>

  {/* ── BEST SELLERS ── */}
  <section class="max-w-[1200px] mx-auto px-6 py-16 md:py-20">
    <div class="flex items-end justify-between mb-10">
      <div>
        <SLabel>Los favoritos</SLabel>
        <h2 style="font-family: 'DM Serif Display', Georgia, serif;" class="text-3xl md:text-4xl text-[#332C29]">
          Más vendidos
        </h2>
      </div>
      <a
        href="/category"
        class="hidden md:flex items-center gap-1.5 text-sm text-[#8E6F62] font-semibold hover:gap-3 transition-all duration-200"
      >
        Ver todos
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {bestsellers.map((p) => (
        <ProductCard
          key={p.id}
          product={p}
          inWishlist={wishlist.includes(p.id)}
        />
      ))}
    </div>
  </section>

  {/* ── BRAND STORY ── */}
  <section class="bg-[#E9DDD7] py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div class="rounded-[24px] overflow-hidden aspect-[4/3] bg-[#D9CFC6]">
          <img
            src="https://images.unsplash.com/photo-1584628805011-382667dc3229?w=800&h=600&fit=crop&auto=format"
            alt="Proceso artesanal"
            class="w-full h-full object-cover"
          />
        </div>
        <div>
          <SLabel>Nuestra historia</SLabel>
          <h2
            style="font-family: 'DM Serif Display', Georgia, serif;"
            class="text-3xl md:text-4xl text-[#332C29] mb-5 leading-tight"
          >
            Cada cuaderno es un objeto pensado para durar.
          </h2>
          <p class="text-[#665C57] leading-relaxed mb-4 text-sm">
            Páginas nació en 2019 en un pequeño taller en Buenos Aires. Desde
            entonces, cada producto es diseñado, seleccionado y ensamblado con
            atención al detalle que pocas marcas se permiten.
          </p>
          <p class="text-[#665C57] leading-relaxed mb-8 text-sm">
            Usamos papeles de alta gramaje, materiales naturales y técnicas de
            encuadernación tradicionales. Creemos que los objetos que tocamos
            todos los días merecen ser hermosos.
          </p>
          <a
            href="/about"
            class="flex items-center gap-2 text-sm text-[#8E6F62] font-semibold hover:gap-3 transition-all duration-200"
          >
            Conocé más sobre nosotros
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ── TESTIMONIALS ── */}
  <section class="max-w-[1200px] mx-auto px-6 py-16 md:py-20">
    <div class="text-center mb-12">
      <SLabel>Testimonios</SLabel>
      <h2 style="font-family: 'DM Serif Display', Georgia, serif;" class="text-3xl md:text-4xl text-[#332C29]">
        Lo que dicen nuestras clientas
      </h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
      {TESTIMONIALS.map((t) => (
        <div
          key={t.id}
          class="bg-[#FFFDFC] border border-[#E6DDD6] rounded-[16px] p-5 flex flex-col gap-4"
        >
          <Stars value={t.rating} size={13} />
          <p class="text-[#665C57] text-sm leading-relaxed flex-1">
            &ldquo;{t.text}&rdquo;
          </p>
          <div class="flex items-center gap-2.5 pt-3 border-t border-[#E6DDD6]">
            <div class="w-8 h-8 rounded-full bg-[#E9DDD7] flex items-center justify-center text-[10px] font-bold text-[#8E6F62] flex-shrink-0">
              {t.initials}
            </div>
            <div>
              <p class="text-xs font-semibold text-[#332C29]">{t.name}</p>
              <p class="text-[10px] text-[#8C817B]">{t.product}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  {/* ── INSTAGRAM ── */}
  <section class="bg-[#F9F5EF] py-16 md:py-20">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="text-center mb-8">
        <SLabel>Instagram</SLabel>
        <h2 style="font-family: 'DM Serif Display', Georgia, serif;" class="text-3xl md:text-4xl text-[#332C29] mb-2">
          @paginas.co
        </h2>
        <p class="text-sm text-[#8C817B]">
          Seguinos y compartí tu rutina de escritura
        </p>
      </div>
      <div class="grid grid-cols-3 md:grid-cols-6 gap-2">
        {INSTAGRAM_IMAGES.map((src, i) => (
          <div
            key={i}
            class="group relative aspect-square rounded-[10px] overflow-hidden bg-[#E9DDD7] cursor-pointer"
          >
            <img
              src={src}
              alt={`@paginas.co post ${i + 1}`}
              class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.05]"
            />
            <div class="absolute inset-0 bg-[#332C29]/0 group-hover:bg-[#332C29]/25 transition-colors duration-200 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── NEWSLETTER ── */}
  <section class="max-w-[1200px] mx-auto px-6 py-16 md:py-20">
    <div class="bg-[#8E6F62] rounded-[24px] px-8 md:px-16 py-12 md:py-14 text-center">
      <SLabel>Newsletter</SLabel>
      <h2
        style="font-family: 'DM Serif Display', Georgia, serif;"
        class="text-3xl md:text-4xl text-[#FFFDFC] mb-3"
      >
        Suscribite y recibí un 10% de descuento
      </h2>
      <p class="text-[#E9DDD7] text-sm mb-8 max-w-sm mx-auto">
        Noticias, lanzamientos exclusivos y tips de escritura, directo a tu
        bandeja de entrada.
      </p>
      <form
        class="flex flex-col sm:flex-row gap-3 max-w-sm mx-auto"
      >
        <input
          type="email"
          placeholder="tu@email.com"
          class="flex-1 px-4 py-3 rounded-full bg-[#FFFDFC]/10 border border-[#E9DDD7]/30 text-[#FFFDFC] placeholder:text-[#E9DDD7]/50 focus:outline-none focus:border-[#E9DDD7]/70 text-sm min-h-[44px]"
        />
        <button
          type="submit"
          class="px-6 py-3 bg-[#FFFDFC] text-[#8E6F62] rounded-full text-sm font-semibold hover:bg-[#F9F5EF] transition-colors duration-200 whitespace-nowrap min-h-[44px]"
        >
          Suscribirme
        </button>
      </form>
    </div>
  </section>
</Layout>

<script>
  // Load wishlist from localStorage for client-side interactivity
  if (typeof localStorage !== 'undefined') {
    const wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]');
    
    // Update wishlist buttons on page load
    document.querySelectorAll('.wishlist-btn').forEach(btn => {
      const productId = btn.dataset.productId;
      if (wishlist.includes(productId)) {
        btn.dataset.wishlist = 'true';
        const icon = btn.querySelector('.wishlist-icon');
        icon.setAttribute('fill', '#E8C8C8');
        icon.setAttribute('stroke', '#E8C8C8');
      }
    });
  }
  
  // Handle add to cart events
  window.addEventListener('add-to-cart', (e) => {
    const productId = e.detail;
    const product = window.PRODUCTS?.find((p: any) => p.id === productId);
    if (product) {
      let cart = JSON.parse(localStorage.getItem('cart') || '[]');
      const existing = cart.find((i: any) => i.product.id === productId);
      if (existing) {
        cart = cart.map((i: any) => i.product.id === productId ? { ...i, quantity: i.quantity + 1 } : i);
      } else {
        cart.push({ product, quantity: 1 });
      }
      localStorage.setItem('cart', JSON.stringify(cart));
      window.dispatchEvent(new CustomEvent('cart-updated'));
      window.dispatchEvent(new CustomEvent('cart-open'));
    }
  });
</script>

<script define:vars={{ PRODUCTS }}>
  window.PRODUCTS = PRODUCTS;
</script>
