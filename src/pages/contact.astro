---
import Layout from "../layouts/Layout.astro";
import SLabel from "../components/ui/SLabel.astro";
---

<Layout title="Contacto — Páginas" current="contact">
  <main class="max-w-[1200px] mx-auto px-6 py-16 md:py-20">
    <div class="text-center mb-12">
      <SLabel>Contacto</SLabel>
      <h1
        style="font-family: 'DM Serif Display', Georgia, serif;"
        class="text-3xl md:text-4xl text-[#332C29] mb-4"
      >
        ¿Tenés alguna consulta?
      </h1>
      <p class="text-[#665C57] max-w-md mx-auto">
        Escribinos y te respondemos a la brevedad. Estamos para ayudarte.
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <div>
        <h2 class="text-lg font-semibold text-[#332C29] mb-6">
          Otras formas de contacto
        </h2>
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-[#F9F5EF] flex items-center justify-center flex-shrink-0">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#8E6F62"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <div>
              <p class="font-medium text-[#332C29] text-sm mb-1">WhatsApp</p>
              <p class="text-sm text-[#665C57]">+54 9 1111111111</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-[#F9F5EF] flex items-center justify-center flex-shrink-0">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#8E6F62"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div>
              <p class="font-medium text-[#332C29] text-sm mb-1">Email</p>
              <p class="text-sm text-[#665C57]">hola@paginas.co</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-[#F9F5EF] flex items-center justify-center flex-shrink-0">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#8E6F62"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div>
              <p class="font-medium text-[#332C29] text-sm mb-1">Ubicación</p>
              <p class="text-sm text-[#665C57]">
                Buenos Aires, Argentina
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-[#F9F5EF] flex items-center justify-center flex-shrink-0">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#8E6F62"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
            </div>
            <div>
              <p class="font-medium text-[#332C29] text-sm mb-1">Horarios</p>
              <p class="text-sm text-[#665C57]">
                Lunes a viernes: 9:00 - 18:00
              </p>
            </div>
          </div>
        </div>

        <div class="mt-8 p-6 bg-[#F9F5EF] rounded-[16px]">
          <h3 class="font-semibold text-[#332C29] text-sm mb-2">
            Seguinos en redes
          </h3>
          <div class="flex gap-3">
            <a
              href="https://instagram.com/paginas.co"
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-[#8E6F62] flex items-center justify-center text-[#FFFDFC] hover:bg-[#6F554A] transition-colors"
              aria-label="Instagram"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>
            <a
              href="https://facebook.com/paginas.co"
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-[#8E6F62] flex items-center justify-center text-[#FFFDFC] hover:bg-[#6F554A] transition-colors"
              aria-label="Facebook"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
