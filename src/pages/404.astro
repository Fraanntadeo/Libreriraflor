---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Página no encontrada — Páginas" current="home">
  <main class="flex flex-col items-center justify-center min-h-[60vh] text-center px-6 py-20">
    <p style="font-family: 'DM Serif Display', Georgia, serif;" class="text-[120px] md:text-[160px] font-bold leading-none text-[#E9DDD7] mb-4 select-none">404</p>
    <h1 style="font-family: 'DM Serif Display', Georgia, serif;" class="text-2xl md:text-3xl text-[#332C29] mb-3">Esta página no existe.</h1>
    <p class="text-[#8C817B] mb-8 text-sm max-w-xs">Puede que hayas escrito mal la dirección o que el contenido haya sido movido.</p>
    <a
      href="/"
      class="px-6 py-3 bg-[#8E6F62] text-[#FFFDFC] rounded-full text-sm font-semibold hover:bg-[#6F554A] transition-colors min-h-[44px] inline-block"
    >
      Volver al inicio
    </a>
  </main>
</Layout>
