---
import Layout from "../layouts/Layout.astro";
import { fmt } from "../utils";
import Breadcrumb from "../components/ui/Breadcrumb.astro";
---

<Layout title="Checkout — Páginas" current="category">
  <main class="max-w-[900px] mx-auto px-6 py-8 md:py-12">
    <div class="mb-6">
      <Breadcrumb items={[
        { label: "Inicio", href: "/" },
        { label: "Tienda", href: "/category" },
        { label: "Checkout" }
      ]} />
    </div>

    <div id="checkout-content">
      <!-- Checkout will be rendered here via JavaScript -->
    </div>
  </main>
</Layout>

<script define:vars={{ fmt }}>
  const checkoutContent = document.getElementById('checkout-content');
  
  const renderCheckout = () => {
    const cart = JSON.parse(localStorage.getItem('cart') || '[]');
    
    if (cart.length === 0) {
      checkoutContent.innerHTML = `
        <div class="text-center py-20">
          <h2 style="font-family: 'DM Serif Display', Georgia, serif;" class="text-xl text-[#332C29] mb-2">Tu carrito está vacío</h2>
          <p class="text-[#8C817B] mb-6 text-sm">Agregá productos para continuar con el checkout</p>
          <a href="/category" class="px-6 py-3 bg-[#8E6F62] text-[#FFFDFC] rounded-full text-sm font-semibold hover:bg-[#6F554A] transition-colors min-h-[44px] inline-block">
            Ir a la tienda
          </a>
        </div>
      `;
      return;
    }
    
    const subtotal = cart.reduce((s, i) => s + i.product.price * i.quantity, 0);
    const shipping = subtotal >= 3000 ? 0 : 500;
    
    checkoutContent.innerHTML = `
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-8">
        <div class="bg-[#FFFDFC] border border-[#E6DDD6] rounded-[16px] p-6">
          <h2 style="font-family: 'DM Serif Display', Georgia, serif;" class="text-xl font-semibold text-[#332C29] mb-5">Datos de envío</h2>
          <form id="checkout-form" class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-[#665C57] mb-1.5">Nombre</label>
              <input type="text" placeholder="Tu nombre" class="w-full px-4 py-2.5 border border-[#E6DDD6] rounded-[10px] text-sm text-[#332C29] focus:outline-none focus:border-[#8E6F62] bg-[#F9F5EF] placeholder:text-[#8C817B] min-h-[44px]" required />
            </div>
            <div>
              <label class="block text-xs font-semibold text-[#665C57] mb-1.5">Apellido</label>
              <input type="text" placeholder="Tu apellido" class="w-full px-4 py-2.5 border border-[#E6DDD6] rounded-[10px] text-sm text-[#332C29] focus:outline-none focus:border-[#8E6F62] bg-[#F9F5EF] placeholder:text-[#8C817B] min-h-[44px]" required />
            </div>
            <div class="col-span-2">
              <label class="block text-xs font-semibold text-[#665C57] mb-1.5">Email</label>
              <input type="email" placeholder="tu@email.com" class="w-full px-4 py-2.5 border border-[#E6DDD6] rounded-[10px] text-sm text-[#332C29] focus:outline-none focus:border-[#8E6F62] bg-[#F9F5EF] placeholder:text-[#8C817B] min-h-[44px]" required />
            </div>
            <div class="col-span-2">
              <label class="block text-xs font-semibold text-[#665C57] mb-1.5">Teléfono</label>
              <input type="tel" placeholder="11 0000-0000" class="w-full px-4 py-2.5 border border-[#E6DDD6] rounded-[10px] text-sm text-[#332C29] focus:outline-none focus:border-[#8E6F62] bg-[#F9F5EF] placeholder:text-[#8C817B] min-h-[44px]" required />
            </div>
            <div class="col-span-2">
              <label class="block text-xs font-semibold text-[#665C57] mb-1.5">Dirección</label>
              <input type="text" placeholder="Calle y número" class="w-full px-4 py-2.5 border border-[#E6DDD6] rounded-[10px] text-sm text-[#332C29] focus:outline-none focus:border-[#8E6F62] bg-[#F9F5EF] placeholder:text-[#8C817B] min-h-[44px]" required />
            </div>
            <div>
              <label class="block text-xs font-semibold text-[#665C57] mb-1.5">Ciudad</label>
              <input type="text" placeholder="Buenos Aires" class="w-full px-4 py-2.5 border border-[#E6DDD6] rounded-[10px] text-sm text-[#332C29] focus:outline-none focus:border-[#8E6F62] bg-[#F9F5EF] placeholder:text-[#8C817B] min-h-[44px]" required />
            </div>
            <div>
              <label class="block text-xs font-semibold text-[#665C57] mb-1.5">Código postal</label>
              <input type="text" placeholder="1000" class="w-full px-4 py-2.5 border border-[#E6DDD6] rounded-[10px] text-sm text-[#332C29] focus:outline-none focus:border-[#8E6F62] bg-[#F9F5EF] placeholder:text-[#8C817B] min-h-[44px]" required />
            </div>
          </form>
          
          <h2 style="font-family: 'DM Serif Display', Georgia, serif;" class="text-xl font-semibold text-[#332C29] mb-5 mt-8">Método de pago</h2>
          <div class="space-y-3 mb-6">
            ${[
              { label: "Tarjeta de crédito / débito", icon: "credit-card" },
              { label: "Mercado Pago", icon: "shield" },
              { label: "Transferencia bancaria", icon: "package" }
            ].map((method, i) => {
              let svgContent = '';
              if (method.icon === "credit-card") {
                svgContent = '<rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line>';
              } else if (method.icon === "shield") {
                svgContent = '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>';
              } else {
                svgContent = '<line x1="16" y1="9" x2="7" y2="4"></line><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>';
              }
              return `
              <label class="flex items-center gap-3 p-4 border border-[#E6DDD6] rounded-[10px] cursor-pointer hover:border-[#8E6F62] transition-colors has-[:checked]:border-[#8E6F62] has-[:checked]:bg-[#F9F5EF]">
                <input type="radio" name="payment" value="${method.label}" ${i === 0 ? 'checked' : ''} class="accent-[#8E6F62]" />
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8E6F62" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  ${svgContent}
                </svg>
                <span class="text-sm text-[#332C29] font-medium">${method.label}</span>
              </label>
            `;
            }).join('')}
          </div>
          
          <div class="grid grid-cols-2 gap-4 mb-6">
            <div class="col-span-2">
              <label class="block text-xs font-semibold text-[#665C57] mb-1.5">Número de tarjeta</label>
              <input type="text" placeholder="0000 0000 0000 0000" class="w-full px-4 py-2.5 border border-[#E6DDD6] rounded-[10px] text-sm text-[#332C29] focus:outline-none focus:border-[#8E6F62] bg-[#F9F5EF] placeholder:text-[#8C817B] min-h-[44px]" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-[#665C57] mb-1.5">Vencimiento</label>
              <input type="text" placeholder="MM / AA" class="w-full px-4 py-2.5 border border-[#E6DDD6] rounded-[10px] text-sm text-[#332C29] focus:outline-none focus:border-[#8E6F62] bg-[#F9F5EF] placeholder:text-[#8C817B] min-h-[44px]" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-[#665C57] mb-1.5">CVV</label>
              <input type="text" placeholder="123" class="w-full px-4 py-2.5 border border-[#E6DDD6] rounded-[10px] text-sm text-[#332C29] focus:outline-none focus:border-[#8E6F62] bg-[#F9F5EF] placeholder:text-[#8C817B] min-h-[44px]" />
            </div>
          </div>
          
          <div class="flex gap-3">
            <a href="/cart" class="px-5 py-3 border border-[#E6DDD6] text-[#665C57] rounded-full text-sm hover:border-[#8E6F62] transition-colors min-h-[44px] inline-block">
              Volver
            </a>
            <button type="submit" form="checkout-form" class="flex-1 py-3 bg-[#8E6F62] text-[#FFFDFC] rounded-full font-semibold text-sm hover:bg-[#6F554A] transition-colors flex items-center justify-center gap-2 min-h-[44px]">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              Confirmar pago
            </button>
          </div>
        </div>

        <div class="bg-[#FFFDFC] border border-[#E6DDD6] rounded-[16px] p-5 h-fit sticky top-20">
          <h3 style="font-family: 'DM Serif Display', Georgia, serif;" class="text-sm font-semibold text-[#332C29] mb-4">Tu pedido</h3>
          <div class="space-y-2.5 mb-4">
            ${cart.map(({ product, quantity }) => `
              <div class="flex justify-between text-sm">
                <span class="text-[#665C57] truncate mr-2">${product.name} ×${quantity}</span>
                <span class="text-[#332C29] flex-shrink-0">${fmt(product.price * quantity)}</span>
              </div>
            `).join('')}
          </div>
          <div class="border-t border-[#E6DDD6] pt-3 space-y-2 text-sm">
            <div class="flex justify-between">
              <span class="text-[#665C57]">Envío</span>
              <span class="${shipping === 0 ? 'text-[#B8C6B2] font-semibold' : 'text-[#332C29]'}">${shipping === 0 ? 'Gratis' : fmt(shipping)}</span>
            </div>
            <div class="flex justify-between font-bold text-[#332C29]">
              <span>Total</span>
              <span>${fmt(subtotal + shipping)}</span>
            </div>
          </div>
        </div>
      </div>
    `;
    
    // Attach form submit handler
    const form = document.getElementById('checkout-form');
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('¡Gracias por tu compra! Esta es una demostración, no se procesará ningún pago real.');
      localStorage.removeItem('cart');
      window.location.href = '/';
    });
  };
  
  // Initial render
  renderCheckout();
  
  // Listen for cart updates
  window.addEventListener('cart-updated', renderCheckout);
</script>
