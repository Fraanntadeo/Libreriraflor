---
import Layout from "../layouts/Layout.astro";
import SLabel from "../components/ui/SLabel.astro";
---

<Layout title="Ayuda — Páginas" current="help">
  <main class="max-w-[1200px] mx-auto px-6 py-16 md:py-20">
    <div class="text-center mb-12">
      <SLabel>Ayuda</SLabel>
      <h1
        style="font-family: 'DM Serif Display', Georgia, serif;"
        class="text-3xl md:text-4xl text-[#332C29] mb-4"
      >
        ¿En qué podemos ayudarte?
      </h1>
      <p class="text-[#665C57] max-w-md mx-auto">
        Encontrá respuestas a las preguntas más frecuentes sobre envíos,
        devoluciones y más.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      <a
        href="#envios"
        class="p-6 bg-[#FFFDFC] border border-[#E6DDD6] rounded-[16px] hover:border-[#8E6F62] transition-colors group"
      >
        <div class="w-12 h-12 rounded-full bg-[#F9F5EF] flex items-center justify-center mb-4 group-hover:bg-[#E9DDD7] transition-colors">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#8E6F62"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        </div>
        <h2 class="font-semibold text-[#332C29] text-lg mb-2">Envíos</h2>
        <p class="text-sm text-[#665C57]">
          Información sobre tiempos, costos y zonas de envío.
        </p>
      </a>

      <a
        href="#devoluciones"
        class="p-6 bg-[#FFFDFC] border border-[#E6DDD6] rounded-[16px] hover:border-[#8E6F62] transition-colors group"
      >
        <div class="w-12 h-12 rounded-full bg-[#F9F5EF] flex items-center justify-center mb-4 group-hover:bg-[#E9DDD7] transition-colors">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#8E6F62"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="1 4 1 10 7 10"></polyline>
            <polyline points="23 20 23 14 17 14"></polyline>
            <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
          </svg>
        </div>
        <h2 class="font-semibold text-[#332C29] text-lg mb-2">Devoluciones</h2>
        <p class="text-sm text-[#665C57]">
          Política de cambios y devoluciones de productos.
        </p>
      </a>

      <a
        href="#faq"
        class="p-6 bg-[#FFFDFC] border border-[#E6DDD6] rounded-[16px] hover:border-[#8E6F62] transition-colors group"
      >
        <div class="w-12 h-12 rounded-full bg-[#F9F5EF] flex items-center justify-center mb-4 group-hover:bg-[#E9DDD7] transition-colors">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#8E6F62"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
        </div>
        <h2 class="font-semibold text-[#332C29] text-lg mb-2">Preguntas frecuentes</h2>
        <p class="text-sm text-[#665C57]">
          Respuestas a las dudas más comunes.
        </p>
      </a>
    </div>

    <section id="envios" class="mb-16">
      <h2
        style="font-family: 'DM Serif Display', Georgia, serif;"
        class="text-2xl text-[#332C29] mb-6"
      >
        Envíos
      </h2>
      <div class="bg-[#FFFDFC] border border-[#E6DDD6] rounded-[16px] p-6 md:p-8">
        <div class="space-y-6">
          <div>
            <h3 class="font-semibold text-[#332C29] mb-2">
              ¿Cuánto cuesta el envío?
            </h3>
            <p class="text-sm text-[#665C57] leading-relaxed">
              El envío es gratuito para compras mayores a $3.000. Para compras
              menores, el costo es de $500 dentro de CABA y Gran Buenos Aires.
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-[#332C29] mb-2">
              ¿Cuánto tarda en llegar mi pedido?
            </h3>
            <p class="text-sm text-[#665C57] leading-relaxed">
              Los envíos a CABA y Gran Buenos Aires demoran entre 2 a 4 días
              hábiles. Para el interior del país, el tiempo puede variar entre
              5 a 8 días hábiles.
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-[#332C29] mb-2">
              ¿Hacen envíos al interior del país?
            </h3>
            <p class="text-sm text-[#665C57] leading-relaxed">
              Sí, enviamos a todo el país a través de correo argentino. Los costos
              y tiempos pueden variar según la zona.
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-[#332C29] mb-2">
              ¿Cómo puedo saber dónde está mi pedido?
            </h3>
            <p class="text-sm text-[#665C57] leading-relaxed">
              Una vez despachado tu pedido, te enviaremos el número de seguimiento
              por WhatsApp o email para que puedas rastrearlo.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="devoluciones" class="mb-16">
      <h2
        style="font-family: 'DM Serif Display', Georgia, serif;"
        class="text-2xl text-[#332C29] mb-6"
      >
        Devoluciones
      </h2>
      <div class="bg-[#FFFDFC] border border-[#E6DDD6] rounded-[16px] p-6 md:p-8">
        <div class="space-y-6">
          <div>
            <h3 class="font-semibold text-[#332C29] mb-2">
              ¿Puedo devolver o cambiar un producto?
            </h3>
            <p class="text-sm text-[#665C57] leading-relaxed">
              Sí, aceptamos cambios y devoluciones dentro de los 30 días posteriores
              a la recepción del producto. El producto debe estar en perfecto
              estado, sin uso y con su packaging original.
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-[#332C29] mb-2">
              ¿Cómo hago un cambio o devolución?
            </h3>
            <p class="text-sm text-[#665C57] leading-relaxed">
              Contactanos por WhatsApp o email indicando tu número de pedido y el
              motivo del cambio. Te guiaremos en el proceso y te diremos cómo
              enviar el producto.
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-[#332C29] mb-2">
              ¿Quién paga el envío de la devolución?
            </h3>
            <p class="text-sm text-[#665C57] leading-relaxed">
              Si la devolución es por un defecto del producto, nosotros asumimos
              el costo del envío. Si es por cambio de opinión, el costo del envío
              corre por tu cuenta.
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-[#332C29] mb-2">
              ¿Cuándo recibo mi reembolso?
            </h3>
            <p class="text-sm text-[#665C57] leading-relaxed">
              Una vez recibido y verificado el producto, el reembolso se realiza
              dentro de los 5 a 10 días hábiles a través del mismo medio de pago
              que usaste para la compra.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="faq">
      <h2
        style="font-family: 'DM Serif Display', Georgia, serif;"
        class="text-2xl text-[#332C29] mb-6"
      >
        Preguntas frecuentes
      </h2>
      <div class="space-y-4">
        <details class="bg-[#FFFDFC] border border-[#E6DDD6] rounded-[16px] group">
          <summary class="p-6 cursor-pointer flex justify-between items-center font-semibold text-[#332C29]">
            ¿Qué métodos de pago aceptan?
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="transition-transform group-open:rotate-180"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <div class="px-6 pb-6 text-sm text-[#665C57]">
            Aceptamos Mercado Pago (tarjetas de crédito, débito, dinero en cuenta),
            transferencia bancaria y efectivo en puntos de pago.
          </div>
        </details>

        <details class="bg-[#FFFDFC] border border-[#E6DDD6] rounded-[16px] group">
          <summary class="p-6 cursor-pointer flex justify-between items-center font-semibold text-[#332C29]">
            ¿Puedo personalizar mi cuaderno?
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="transition-transform group-open:rotate-180"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <div class="px-6 pb-6 text-sm text-[#665C57]">
            Sí, ofrecemos personalización de tapas con nombres, frases o diseños.
            Consultanos por WhatsApp para ver opciones y precios.
          </div>
        </details>

        <details class="bg-[#FFFDFC] border border-[#E6DDD6] rounded-[16px] group">
          <summary class="p-6 cursor-pointer flex justify-between items-center font-semibold text-[#332C29]">
            ¿Qué tipo de papel usan?
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="transition-transform group-open:rotate-180"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <div class="px-6 pb-6 text-sm text-[#665C57]">
            Usamos papel de 80 gramos de alta calidad, apto para todo tipo de
            escritura (birome, lápiz, marcadores). También contamos con opciones
            de papel de mayor gramaje para acuarelas.
          </div>
        </details>

        <details class="bg-[#FFFDFC] border border-[#E6DDD6] rounded-[16px] group">
          <summary class="p-6 cursor-pointer flex justify-between items-center font-semibold text-[#332C29]">
            ¿Hacen pedidos personalizados para eventos?
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="transition-transform group-open:rotate-180"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <div class="px-6 pb-6 text-sm text-[#665C57]">
            Sí, realizamos pedidos personalizados para bodas, cumpleaños, eventos
            corporativos y regalos empresariales. Contactanos con anticipación para
            cotizar tu pedido.
          </div>
        </details>

        <details class="bg-[#FFFDFC] border border-[#E6DDD6] rounded-[16px] group">
          <summary class="p-6 cursor-pointer flex justify-between items-center font-semibold text-[#332C29]">
            ¿Los productos son hechos a mano?
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="transition-transform group-open:rotate-180"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <div class="px-6 pb-6 text-sm text-[#665C57]">
            La mayoría de nuestros productos son ensamblados y terminados a mano
            en nuestro taller de Buenos Aires, prestando atención a cada detalle
            para garantizar la mejor calidad.
          </div>
        </details>
      </div>
    </section>

    <div class="mt-16 text-center">
      <p class="text-[#665C57] text-sm mb-4">
        ¿No encontraste la respuesta que buscabas?
      </p>
      <a
        href="/contact"
        class="px-6 py-3 bg-[#8E6F62] text-[#FFFDFC] rounded-full font-semibold text-sm hover:bg-[#6F554A] transition-colors duration-200 inline-block"
      >
        Contactanos
      </a>
    </div>
  </main>
</Layout>
